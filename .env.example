# Скопируйте этот файл в .env и укажите ключ ОДНОГО провайдера.
# Файл .env в git не попадает (.gitignore). Никогда не коммитьте реальные ключи.

# Какой провайдер использовать: gemini | anthropic | openai
# Если не указан — выбирается по тому, какой ключ задан ниже.
LLM_PROVIDER=gemini

# --- Google Gemini (бесплатно) ------------------------------------------------
# Ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude (платно, лучшее качество) ------------------------------
# Ключ: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждений: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Серверный fallback на другую модель при отказе (1 — включён, 0 — выключен)
ANTHROPIC_FALLBACKS=1

# --- OpenAI или OpenAI-совместимый сервер (Ollama, vLLM, LM Studio) ----------
# Для Ollama: OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6.2-sol

# --- Параметры агента ---------------------------------------------------------
# Сколько требований проверять за один запрос к модели
BATCH_SIZE=10
